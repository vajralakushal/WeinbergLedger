source 'https://rubygems.org'

# sinatra 3.x supports Ruby 2.6+; sinatra 4 requires 2.7+
gem 'sinatra', '~> 3.0'

# sqlite3 1.4+ supports Ruby 2.x; 2.x requires Ruby 3.1+
# Bundler will pick the newest 1.x compatible with the local Ruby version.
gem 'sqlite3', '~> 1.5'
gem 'webrick'
gem 'puma'
gem 'falcon'
gem 'thin'

gem 'json'
gem 'ostruct'
gem 'logger'
gem 'base64'
gem 'csv'

group :test do
  gem 'minitest', '~> 5.0'
  gem 'rack-test'
end
